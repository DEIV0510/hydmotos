{
  "rewrites": [
    { "source": "/api/admin/:recurso", "destination": "/api/admin?recurso=:recurso" },
    { "source": "/api/public/:recurso", "destination": "/api/public?recurso=:recurso" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:ruta*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
